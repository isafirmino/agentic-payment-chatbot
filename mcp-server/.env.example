# Copie pra .env e preencha. .env nunca é commitado (ver .gitignore).

# Banco SQLite compartilhado com o api-auth (ver ADR 0003). O caminho é
# resolvido a partir da raiz deste pacote, não de onde o comando foi
# executado, então o valor abaixo cai sempre em <repo>/data/app.db.
# Se mudar aqui, mude igual no .env do api-auth: os dois serviços
# precisam abrir o MESMO arquivo, senão o limite de gasto gravado no
# cadastro não é o mesmo que a compra valida.
DATABASE_PATH=../data/app.db

# Mesmo segredo usado pelo api-auth para assinar os JWTs (sub = CPF).
# Em produção esta variável é obrigatória; o fallback existe apenas
# para facilitar o desenvolvimento local.
JWT_SECRET=

# Porta HTTP deste serviço. É pra cá que o MCP_URL do chat-web aponta.
PORT=4000
