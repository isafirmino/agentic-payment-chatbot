# Copie pra .env e preencha. .env nunca é commitado (ver .gitignore).

# Servidor de autenticação (Task #5) — base URL do api-auth.
NEXT_PUBLIC_AUTH_URL=http://localhost:3001

# Ollama local — provedor primário. Se não estiver acessível, cai
# automaticamente pro OpenRouter (ver OPENROUTER_* abaixo).
OLLAMA_URL=http://localhost:11434

# O chat manda as tools pelo /api/chat do Ollama, então o modelo precisa
# suportar tool calling NATIVO — um modelo sem isso conversa normalmente e
# simplesmente nunca chama as ferramentas, o que parece um bug do projeto.
#
# O padrão abaixo ocupa ~9 GB e não cabe numa placa de 4 GB de VRAM: sobra
# pra CPU e a resposta cai pra poucos tokens por segundo. Alternativas da
# mesma família, todas com tool calling nativo:
#
#   qwen2.5:14b  ~9,0 GB  precisa de ~12 GB de VRAM pra rodar folgado
#   qwen2.5:7b   ~4,7 GB  roda em 4 GB com offload parcial — usado nas
#                         evidências do README (ver docs/teste-manual.md)
#   qwen2.5:3b   ~1,9 GB  cabe inteiro em 4 GB e é o mais rápido, mas erra
#                         mais na hora de escolher e encadear as tools
OLLAMA_MODEL=qwen2.5:14b

# Servidor MCP com as tools.
MCP_URL=http://localhost:4000/mcp

# OpenRouter — fallback automático quando o Ollama não responde. Gere uma
# chave gratuita em https://openrouter.ai/keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
