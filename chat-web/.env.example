# Copie pra .env e preencha. .env nunca é commitado (ver .gitignore).

# Servidor de autenticação (Task #5) — base URL do api-auth.
NEXT_PUBLIC_AUTH_URL=http://localhost:3001

# Ollama local — provedor primário. Se não estiver acessível, cai
# automaticamente pro OpenRouter (ver OPENROUTER_* abaixo).
OLLAMA_URL=http://localhost:11434

# O chat manda as tools pelo /api/chat do Ollama, então o modelo precisa
# suportar tool calling NATIVO. Mas suportar não basta: ele precisa acertar os
# ARGUMENTOS. Modelos pequenos falham de formas que parecem bug do projeto:
#
#   qwen2.5:7b   narra "registrei sua intenção" sem chamar ferramenta nenhuma
#   llama3.1:8b  chama a ferramenta certa com argumento errado — manda
#                {"produto_id":"Fone Bluetooth"} em vez de "prod_001", e
#                quantidade como string em vez de número
#
# Ambos foram medidos rodando a aplicação de verdade (ver docs/teste-manual.md).
# Se for usar Ollama, valide o fluxo completo antes de confiar: um modelo que
# conversa bem pode nunca fechar uma compra.
#
# O padrão abaixo ocupa ~9 GB e precisa de ~12 GB de VRAM pra rodar folgado.
OLLAMA_MODEL=qwen2.5:14b

# Servidor MCP com as tools.
MCP_URL=http://localhost:4000/mcp

# OpenRouter — fallback automático quando o Ollama não responde, e o provedor
# usado nas evidências do README. Gere uma chave gratuita em
# https://openrouter.ai/keys. A chave fica só aqui: .env não é commitado.
OPENROUTER_API_KEY=

# `openrouter/free` é um roteador sobre os modelos gratuitos com tool calling
# (dos 400+ modelos do catálogo, só 18 são gratuitos E suportam tools). Nas
# evidências ele resolveu para `minimax/minimax-m3:free`. Como é roteador, o
# modelo concreto pode variar entre requisições; fixe um id específico aqui se
# precisar de reprodutibilidade exata.
#
# ⚠️  O tier gratuito tem limite de 50 requisições por DIA, e cada turno do
# chat consome uma. Estourado, a resposta vira erro 429 no chat. O reset é
# diário; adicionar US$ 10 de crédito sobe o limite pra 1000/dia.
OPENROUTER_MODEL=openrouter/free
