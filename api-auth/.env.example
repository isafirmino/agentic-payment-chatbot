# Copie pra .env e preencha. .env nunca é commitado (ver .gitignore).

# Banco SQLite compartilhado com o mcp-server (ver ADR 0003). O caminho é
# resolvido a partir da raiz deste pacote, não de onde o comando foi
# executado, então o valor abaixo cai sempre em <repo>/data/app.db.
# Se mudar aqui, mude igual no .env do mcp-server: os dois serviços
# precisam abrir o MESMO arquivo, senão o limite de gasto gravado no
# cadastro não é o mesmo que a compra valida.
DATABASE_PATH=../data/app.db

# Porta HTTP deste serviço. O chat-web (next dev) também usa 3000 por
# padrão, então trocar pra 3001 evita conflito.
PORT=3001

# Limite de gasto padrão para novo usuário (em centavos). Aceita zero;
# valores negativos, fracionários ou inválidos impedem o boot.
DEFAULT_LIMITE_CENTS=100000

# Segredo de assinatura do JWT. ⚠️  COMPARTILHADO COM MCP-SERVER — use o
# mesmo valor nos dois .env. Fora de produção, vazio usa o fallback do
# workshop; em produção é obrigatório e o serviço recusa iniciar sem ele.
JWT_SECRET=

# Origem permitida no CORS: precisa ser a URL de onde o chat-web é servido,
# senão o navegador bloqueia o fetch de /auth/cadastro e /auth/login com
# "Failed to fetch" antes mesmo da resposta chegar ao JS.
CORS_ORIGIN=http://localhost:3000
